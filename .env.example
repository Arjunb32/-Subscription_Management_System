# Copy with scripts/create_env.py; never commit .env or real credentials.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=subscription_management
DB_USER=subscription_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# This computer's existing PostgreSQL uses port 7129; change DB_PORT locally.
# Tests require separate credentials and a separate database name.
TEST_DB_NAME=test_subscription_management
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.invalid
# Use the same local hostname/port as the Django-served reset form.
PASSWORD_RESET_URL=http://localhost:8000/reset-password/
CSRF_TRUSTED_ORIGINS=
